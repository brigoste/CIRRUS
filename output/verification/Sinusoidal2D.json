{
  "extends": "../base.json",

  "mesh": {
    "type": "quad2D",
    "nx": 50,
    "ny": 50,
    "lx": 1.0,
    "ly": 1.0
  },

  "boundary_conditions": [
    { "group": 0, "type": "Dirichlet", "value": 0.0 },
    { "group": 1, "type": "Dirichlet", "value": 0.0 },
    { "group": 2, "type": "Dirichlet", "value": 0.0 },
    { "group": 3, "type": "Dirichlet", "value": 0.0 }
  ],

  "verification": {
    "enabled": true,
    "case_name": "Sinusoidal2D",
    "plot_enabled": true,

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "output/validation/Sinusoidal2D.csv",
      "summary": "output/validation/Sinusoidal2D.json"
    }
  }
}
