{
  "mesh": {
      "type":"line1D",
      "nx":20,
      "lx":1.5,
      "comment": "Syntax for a 1D mesh",
      "notes":{
          "mesh":{     
              "type":"quad2D",   
              "nx":150,
              "ny":100,
              "lx":15,
              "ly":10,
              "comment": "Syntax for a 2D mesh"
          }
      } 
  },

  "physics": {
    "type": "heat",
    "k": 100.0,
    "Su": 0.0,
    "Sp": -1000.0
  },

  "boundary_conditions": [
    { "group": 0, "type": "Dirichlet", "value": 300 },
    { "group": 1, "type": "Dirichlet", "value": 400 },
    { "group": 2, "type": "Neumann", "flux": 0 },
    { "group": 3, "type": "Neumann", "flux": 0 }
  ],

  "_comment": "Solver types: TDMA, GS, SOR, CG",

  "solver": {

    "notes": {
      "purpose": "Setup for the solver. Determine which to use and the inputs for it.",
      "Solver_types": "TDMA, GS, SOR, CG"
    },

    "type": "TDMA",
    "tol": 1e-12,
    "max_iter": 5000,
    "omega": 1.2    
  },

  "verification": {
    "enabled": true,
    "case_name": "1Dlinear",

    "type": "manufactured",

    "manufactured": {
      "phi_expr": "(100/L)*x + 300",
      "source_expr": "0",
      "notes":{
        "phi_expr": "sin(pi*x)*sin(pi*y)",
        "source_expr": "2*pi*pi*sin(pi*x)*sin(pi*y)"
      }
    },

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "output/validation/verification.csv",
      "summary": "output/validation/verification.json"
    }
  }
}
