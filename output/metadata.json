{
  "mesh": {
      
      "type":"quad2D",
      "nx":20,
      "ny":10,
      "lx":1.5,
      "ly":0.75,
      "comment": "Syntax for a 2D mesh",
      "notes":{
        "mesh":
              {
                "type":"line1D",
                "nx":20,
                "lx":1.5,
                "comment": "Syntax for a 1D mesh"
              }
      } 
  },

  "physics": {
    "type": "heat",
    "k": 100.0
  },

  "source": {
    "Su": 0.0,
    "Sp": 0.0
  },

  "boundary_conditions": [
    { "group": 0, "type": "Dirichlet", "value": 400 },
    { "group": 1, "type": "Dirichlet", "value": 300 },
    { "group": 2, "type": "Neumann", "flux": 0 },
    { "group": 3, "type": "Neumann", "flux": 0 }
  ],

  "_comment": "Solver types: TDMA, GS, SOR, CG",

  "solver": {

    "notes": {
      "purpose": "Setup for the solver. Determine which to use and the inputs for it.",
      "Solver_types": "TDMA, GS, SOR, CG"
    },

    "type": "CG",
    "tol": 1e-12,
    "max_iter": 5000,
    "omega": 1.2    
  },

  "verification": {
    "enabled": false,
    "case_name": "sinusoidal",

    "type": "manufactured",

    "manufactured": {
      "phi_expr": "sin(pi*x)*sin(pi*y)",
      "source_expr": "2*pi*pi*sin(pi*x)*sin(pi*y)"
    },

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "output/verification.csv",
      "summary": "output/verification.json"
    }
  }
}
