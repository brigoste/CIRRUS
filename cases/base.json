{
  "mesh": {
    "type": "line1D",
    "nx": 50,
    "ny": 1,
    "lx": 1.0,
    "ly": 1.0
  },

  "physics": {
    "type": "heat",
    "k": 1.0
  },

  "solver": {
    "type": "SOR",
    "preconditioner": "None",
    "restart": 30,
    "tol": 1e-8,
    "max_iter": 5000,
    "omega": 1.0
  },

  "boundary_conditions": [
    {
      "group": 0,
      "type": "Dirichlet",
      "value": 0.0
    },
    {
      "group": 1,
      "type": "Dirichlet",
      "value": 1.0
    }
  ],

  "paths": {
    "python_executable": "python"
  },

  "verificationSuite": {
    "enabled": true,
    "plot_enabled": false,

    "output": {
      "directory": "verification"
    }
  }
}
