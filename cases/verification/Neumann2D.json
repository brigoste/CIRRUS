{
  "extends": "../base.json",

  "verificationCase": {
    "name": "Neumann2D",
    "type": "manufactured",

    "mesh": {
      "type": "quad2D",
      "nx": 200,
      "ny": 200,
      "lx": 1.0,
      "ly": 1.0
    },

    "refinement": {
      "enabled": true,
      "levels": [25, 50, 100, 200],
      "expected_order": 2.0
    },

    "physics": {
      "type": "heat",
      "k": 100.0
    },

    "solver": {
      "method": "CG",
      "tol": 1e-8,
      "max_iter": 5000
    },

    "boundary_conditions": [
      {
        "group": 0,
        "type": "Dirichlet",
        "value": 0.0
      },
      {
        "group": 1,
        "type": "Neumann",
        "flux": -11000.0
      },
      {
        "group": 2,
        "type": "Neumann",
        "flux": -1500.0
      },
      {
        "group": 3,
        "type": "Neumann",
        "flux": -9500.0
      }
    ],

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Neumann2D.csv",
      "summary": "Neumann2D.json"
    }
  }
}
