{
  "extends": "../../base.json",

  "mesh": {
    "type": "quad2D",
    "nx": 50,
    "ny": 50,
    "lx": 1.0,
    "ly": 1.0
  },

  "physics": {
    "type": "advection-diffusion",
    "k": 1.0,
    "rho": 1.0,
    "ux": 1.0,
    "uy": 0.2,
    "uz": 0.0
  },

  "solver": {
    "type": "BiCGSTAB",
    "tol": 1e-8,
    "max_iter": 5000
  },

  "boundary_conditions": [
    { "group": 0, "type": "Dirichlet", "value": 0.0 },
    { "group": 1, "type": "Dirichlet", "value": 0.0 },
    { "group": 2, "type": "Dirichlet", "value": 0.0 },
    { "group": 3, "type": "Dirichlet", "value": 0.0 }
  ],

  "verificationCase": {
    "cases": [
      {
        "case_name": "AdvectionDiffusion2D",
        "params": {
          "k": 100.0,
          "ux": 1.0,
          "uy": 0.0,
          "uz": 0.0,
          "gamma": 1.0
        }
      }
    ],
    "type": "manufactured",
    "enabled": true,
    "plot_enabled": true,

    "manufactured": {
      "phi_expr": "sin(pi*x)*sin(pi*y)"
    },

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "AdvectionDiffusion2D.csv",
      "summary": "AdvectionDiffusion2D.json"
    }
  }
}
