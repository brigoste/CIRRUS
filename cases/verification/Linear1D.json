{
  "extends": "../../base.json",

  "mesh": {
    "type": "line1D",
    "nx": 20,
    "lx": 1.5
  },

  "boundary_conditions": [
    { "group": 0, "type": "Dirichlet", "value": 300 },
    { "group": 1, "type": "Dirichlet", "value": 400 }
  ],

  "verificationCase": {
    "type": "manufactured",
    "plot_enabled": true,

    "manufactured": {
      "phi_expr": "(100/L)*x + 300",
      "source_expr": "0"
    },

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Linear1D.csv",
      "summary": "Linear1D.json"
    }
  }
}
