{
  "extends": "../base.json",

  "verificationCase": {
    "name": "Convective2D",
    "type": "manufactured",

    "mesh": {
      "type": "quad2D",
      "nx": 256,
      "ny": 256,
      "lx": 1.0,
      "ly": 1.0
    },

    "refinement": {
      "enabled": false,
      "levels": [16,32,64,128,256],
      "expected_order": 2.0
    },

    "physics": {
      "type": "heat",
      "k": 100.0,
      "volumetricSource": 400.0
    },

    "solver": {
      "type": "CG",
      "tol": 1e-8,
      "max_iter": 5000
    },

    "boundary_conditions": [
        {
            "group": 0,
            "type": "Dirichlet",
            "value": 100.0
        },
        {
            "group": 1,
            "type": "Convective",
            "h": 10.0,
            "ambientTemperature": 93.0
        },
        {
            "group": 2,
            "type": "Neumann",
            "flux": 0.0
        },
        {
            "group": 3,
            "type": "Neumann",
            "flux": 0.0
        }
    ],

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Convective2D.csv",
      "summary": "Convective2D.json"
    }
  }
}
