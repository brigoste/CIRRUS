{
  "extends": "../base.json",

  "verificationCase": {
    "name": "Neumann1D",
    "type": "manufactured",

    "mesh": {
      "type": "line1D",
      "nx": 200,
      "lx": 1.0
    },

    "refinement": {
        "enabled": true,
        "levels": [25,50,100,200],
        "expected_order": 2.0
    },

    "physics": {
      "type": "heat",
      "k": 100.0,
      "volumetricSource": -10000.0
    },

    "solver": {
      "type": "TDMA",
      "tol": 1e-8,
      "max_iter": 5000
    },

    "boundary_conditions": [
      {
        "group": 0,
        "type": "Dirichlet",
        "value": 100.0
      },
      {
        "group": 1,
        "type": "Neumann",
        "flux": -10000.0
      }
    ],

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Neumann1D.csv",
      "summary": "Neumann1D.json"
    }
  }
}
