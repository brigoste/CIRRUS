{
  "extends": "../../base.json",

  "verificationCase": {
    "name": "Robin1D",
    "type": "manufactured",

    "mesh": {
      "type": "line1D",
      "nx": 200,
      "lx": 1.0
    },

    "refinement": {
      "enabled": false,
      "levels": [25,50,100,200],
      "expected_order": 2.0
    },

    "acceptance": {
      "qoiGciTolerance": 0.05
    },

    "physics": {
      "type": "heat",
      "transferCoefficient": 100.0,
      "volumetricSource": -200.0
    },

    "solver": {
      "method": "TDMA",
      "tol": 1e-8,
      "max_iter": 5000
    },

    "boundary_conditions": [
      {
        "group": 0,
        "type": "Dirichlet",
        "value": 1.0
      },
      {
        "group": 1,
        "type": "Robin",
        "transferCoefficient": 10.0,
        "referenceValue": 84.0
      }
    ],

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Robin1D.csv",
      "summary": "Robin1D.json"
    }
  }
}
