{
  "extends": "../../base.json",

  "verificationCase": {
    "name": "Sinusoidal2D",
    "type": "manufactured",

    "mesh": {
      "type": "quad2D",
      "nx": 50,
      "ny": 50,
      "lx": 1.0,
      "ly": 1.0
    },

    "refinement": {
      "enabled": true,
      "levels": [25, 50, 100, 200],
      "expected_order": 2.0
    },

    "acceptance": {
      "qoiGciTolerance": 0.05
    },

    "discretization": {
        "gradientScheme": "least_squares",
        "reconstructionScheme": "Upwind"
    },

    "physics": {
      "type": "heat",
      "gamma": 1.0,
      "ux": 0.0,
      "uy": 0.0
    },

    "solver": {
      "method": "GMRES",
      "preconditioner": "ILU0",
      "tol": 1e-8,
      "max_iter": 5000,
      "restart": 10
    },

    "boundary_conditions": [
      {
        "group": 0,
        "type": "Dirichlet",
        "value": 0.0
      },
      {
        "group": 1,
        "type": "Dirichlet",
        "value": 0.0
      },
      {
        "group": 2,
        "type": "Dirichlet",
        "value": 0.0
      },
      {
        "group": 3,
        "type": "Dirichlet",
        "value": 0.0
      }
    ],

    "norms": {
      "l2": true,
      "linf": true
    },

    "output": {
      "csv": "Sinusoidal2D.csv",
      "summary": "Sinusoidal2D.json"
    }
  }
}
