    "boundary_conditions": [
        {
            "group": 0,
            "type": "Dirichlet",
            "value": 200.0
        },
        {
            "group": 1,
            "type": "Robin",
            "transferCoefficient": 10.0,
            "referenceValue": 50.0
        },
        {
            "group": 2,
            "type": "Neumann",
            "flux": 0.0
        },
        {
            "group": 3,
            "type": "Neumann",
            "flux": 0.0
        }
    ],

    "norms": {
      "l2": true,
      "linf": true
    }
}
