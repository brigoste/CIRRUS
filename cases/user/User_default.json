{
  "extends": [
    "../base.json"
  ],

  "case_name": "User_advection",

  "mesh": {
      "type": "quad2D",
      "nx": 1000,
      "ny": 1000,
      "lx": 50.0,
      "ly": 50.0
    },

    "discretization": {
        "gradientScheme": "least_squares",
        "reconstructionScheme": "TVD",
        "flux_limiter": "minmod"
    },

    "refinement": {
      "enabled": false,
      "levels": [16,32,64,128,256],
      "expected_order": 2.0
    },

    "physics": {
      "type": "heat",
      "transferCoefficient": 100.0,
      "volumetricSource": 0.0
    },

    "solver": {
      "method": "BiCGSTAB",
      "tol": 1e-8,
      "max_iter": 5000,
      "preconditioner": "Jacobi",
      "Preconditioner Options": "None, Jacobi, ILU0"
    },

    "boundary_conditions": [
      {
        "group": 0,
        "type": "Dirichlet",
        "value": 2500.0
      },
      {
        "group": 1,
        "type": "Dirichlet",
        "value": 2000.0
      },
      {
        "group": 2,
        "type": "Neumann",
        "flux": 0.0
      },
      {
        "group": 3,
        "type": "Dirichlet",
        "value": 1000.0
      }
    ],

    "norms": {
      "l2": true,
      "linf": true
    }
}
