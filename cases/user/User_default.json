{
  "extends": [
    "../base.json"
  ],

  "case_name": "User_advection",

  "mesh": {
      "type": "quad2D",
      "nx": 50,
      "ny": 50,
      "lx": 1.0,
      "ly": 1.0
    },

    "refinement": {
      "enabled": false,
      "levels": [16,32,64,128,256],
      "expected_order": 2.0
    },

    "physics": {
      "type": "heat",
      "transferCoefficient": 100.0,
      "volumetricSource": 400.0
